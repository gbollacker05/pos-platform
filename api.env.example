# ==== API (.env) ====
APP_ENV=prod
JWT_SECRET=change_me_super_secret

# Database
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER:-pos}:${POSTGRES_PASSWORD:-pospw}@db:5432/${POSTGRES_DB:-posdb}

# CORS
CORS_ORIGINS=http://localhost

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info
